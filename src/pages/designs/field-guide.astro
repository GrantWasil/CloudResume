---
import ConceptLayout from "../../layouts/ConceptLayout.astro";
import { practices, selectedWork } from "../../data/designContent";

interface Props {
  isPreview?: boolean;
}

const { isPreview = true } = Astro.props;
const homeHref = isPreview ? "/designs/field-guide/" : "/";
---

<ConceptLayout
  title={isPreview ? "Field Guide" : "Grant Wasil — AI Integration Engineer"}
  description={isPreview
    ? "A grounded, editorial design direction for Grant Wasil"
    : "I help organizations turn AI possibility into sound direction, stronger capability, and working systems."}
  current="field-guide"
  themeColor="#ece5d5"
  preview={isPreview}
>
  <header class="field-header">
    <a class="field-mark" href={homeHref} aria-label="Grant Wasil, home">
      <span>GW</span>
      <strong>Grant Wasil</strong>
    </a>
    <nav aria-label="Concept navigation">
      <a href="#practice">Practice</a>
      <a href="#work">Work</a>
      <a href="#about">About</a>
    </nav>
    <a class="field-contact" href="#contact">Compare notes ↗</a>
  </header>

  <main id="main-content">
    <section class="field-hero" aria-labelledby="field-title">
      <div class="field-hero__index">
        <span>Field notes / 2026</span>
        <span>39.6133° N / 105.0166° W</span>
      </div>
      <div class="field-hero__copy">
        <p class="field-role">AI Integration Engineer · Littleton, Colorado</p>
        <h1 id="field-title">
          Read the terrain.<br />
          <em>Build the route.</em>
        </h1>
        <p class="field-lede">
          I help leaders turn AI possibility into sound direction, stronger
          human capability, and working systems.
        </p>
        <div class="field-actions">
          <a href="#work">Follow the work <span>↓</span></a>
          <p>Strategy should end in something people can use.</p>
        </div>
      </div>
      <figure class="field-hero__portrait">
        <div class="field-hero__contours" aria-hidden="true">
          <svg viewBox="0 0 500 640" role="presentation">
            <path d="M-40 516C76 437 72 321 196 308c93-10 105 94 194 83 70-8 112-80 174-119" />
            <path d="M-47 553c144-80 123-196 254-212 88-11 99 85 186 75 81-9 112-91 183-126" />
            <path d="M-53 593c169-75 145-203 272-219 86-11 88 80 176 68 91-12 119-103 194-136" />
            <path d="M-58 632c191-65 168-201 288-221 88-14 80 73 167 61 102-14 131-111 204-142" />
            <path d="M84 173c43-68 133-81 201-42 53 31 67 103 125 113 58 10 95-46 148-73" />
            <path d="M59 142c55-80 158-92 237-45 57 33 67 103 120 113 64 13 105-44 162-76" />
          </svg>
        </div>
        <img
          src="/grant-wasil-800.webp"
          width="800"
          height="534"
          alt="Grant Wasil smiling in a sunlit office"
        />
        <figcaption>
          <span>Portrait / Summer ’26</span>
          <span>Elevation: 5,351 ft</span>
        </figcaption>
      </figure>
      <aside class="field-hero__note">
        <span>Working question</span>
        <p>How does possibility become dependable practice?</p>
      </aside>
    </section>

    <section class="field-practice" id="practice" aria-labelledby="field-practice-title">
      <header>
        <p>Route notes / 01–03</p>
        <h2 id="field-practice-title">Strategy, close enough<br />to implementation.</h2>
      </header>
      <ol>
        {practices.map((item) => (
          <li>
            <span>{item.number}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <blockquote class="field-principle">
      <span>Trail principle № 7</span>
      <p>AI implementation is not a software rollout.</p>
      <strong>It is a redesign of decisions, capabilities, and systems.</strong>
    </blockquote>

    <section class="field-work" id="work" aria-labelledby="field-work-title">
      <header>
        <p>Selected trails</p>
        <h2 id="field-work-title">Evidence left in the field.</h2>
      </header>
      <div class="field-work__list">
        {selectedWork.map((item) => (
          <a href={item.href}>
            <span class="field-work__number">{item.number}</span>
            <div>
              <p>{item.type}</p>
              <h3>{item.title}</h3>
            </div>
            <p class="field-work__description">{item.description}</p>
            <span class="field-work__arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="field-about" id="about" aria-labelledby="field-about-title">
      <div class="field-about__label">
        <span>Personal bearing</span>
        <span>True north → useful work</span>
      </div>
      <div class="field-about__copy">
        <h2 id="field-about-title">I came to AI through systems, not hype.</h2>
        <p>
          My path runs through customer-facing work, web development, election
          operations, and site reliability engineering. Today I work across AI
          strategy, adoption, education, venture design, and hands-on product
          development.
        </p>
        <p>
          Away from the diagram, you’ll usually find me around a board game,
          in the Colorado mountain air, or building a space where curious
          people can learn from one another.
        </p>
      </div>
      <div class="field-about__stamp" aria-hidden="true">
        <span>CO</span>
        <small>MAKE<br />THE MAP<br />TOGETHER</small>
      </div>
    </section>
  </main>

  <footer class="field-footer" id="contact">
    <p class="field-role">Open trail / useful conversation</p>
    <h2>Working through the messy middle?</h2>
    <a href="mailto:dev@grantwasil.com">dev@grantwasil.com ↗</a>
    <div>
      <span>Grant Wasil · Littleton, Colorado</span>
      <nav aria-label="Social links">
        <a href="https://www.linkedin.com/in/grant-wasil/" rel="me">LinkedIn</a>
        <a href="https://github.com/GrantWasil" rel="me">GitHub</a>
        <a href="https://x.com/GrantWasil" rel="me">X</a>
      </nav>
    </div>
  </footer>
</ConceptLayout>

<style>
  :global(body) {
    --paper: #ece5d5;
    --ink: #203027;
    --rust: #b44b2d;
    --moss: #496452;
    --rule: rgba(32, 48, 39, 0.28);
    color: var(--ink);
    background:
      linear-gradient(rgba(32, 48, 39, 0.025) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 1.8rem;
    font-family: "Public Sans Variable", Arial, sans-serif;
    line-height: 1.55;
  }

  :global(::selection) {
    color: var(--paper);
    background: var(--rust);
  }

  :global(a:focus-visible) {
    outline: 3px solid var(--rust);
    outline-offset: 4px;
  }

  .field-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 6rem;
    padding: 1rem clamp(1.25rem, 4vw, 4.5rem);
    border-bottom: 1px solid var(--ink);
  }

  .field-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    width: max-content;
    color: inherit;
    text-decoration: none;
  }

  .field-mark span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    color: var(--paper);
    background: var(--ink);
    border-radius: 50%;
    font-family: "Fraunces Variable", Georgia, serif;
  }

  .field-mark strong {
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
  }

  .field-header nav {
    display: flex;
    gap: 2.4rem;
  }

  .field-header nav a,
  .field-contact {
    color: inherit;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .field-contact {
    justify-self: end;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--rust);
  }

  .field-hero {
    display: grid;
    grid-template-areas:
      "index index"
      "copy portrait"
      "note portrait";
    grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.9fr);
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - 6rem);
    border-bottom: 1px solid var(--ink);
  }

  .field-hero__index {
    display: flex;
    grid-area: index;
    justify-content: space-between;
    padding: 0.75rem clamp(1.25rem, 4vw, 4.5rem);
    border-bottom: 1px solid var(--rule);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .field-hero__copy {
    display: flex;
    grid-area: copy;
    flex-direction: column;
    justify-content: center;
    padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 4vw, 4.5rem);
  }

  .field-role,
  .field-practice header > p,
  .field-work header > p {
    margin: 0 0 1.6rem;
    color: var(--rust);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: "Fraunces Variable", Georgia, serif;
  }

  .field-hero h1 {
    max-width: 10ch;
    margin-bottom: 2rem;
    font-size: clamp(4rem, 7.4vw, 8.5rem);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.06em;
  }

  .field-hero h1 em {
    color: var(--rust);
    font-weight: 360;
  }

  .field-lede {
    max-width: 36rem;
    margin-bottom: 2.5rem;
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    line-height: 1.28;
  }

  .field-actions {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .field-actions a {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.1rem;
    color: var(--paper);
    background: var(--ink);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .field-actions p {
    max-width: 16rem;
    margin: 0;
    color: var(--moss);
    font-size: 0.78rem;
    font-style: italic;
  }

  .field-hero__portrait {
    position: relative;
    grid-area: portrait;
    min-height: 38rem;
    margin: 0;
    overflow: hidden;
    background: var(--moss);
    border-left: 1px solid var(--ink);
  }

  .field-hero__portrait img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: 52% center;
    filter: saturate(0.72) sepia(0.08);
  }

  .field-hero__contours {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .field-hero__contours svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgba(236, 229, 213, 0.65);
    stroke-width: 1.25;
  }

  .field-hero__portrait figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    padding: 0.8rem 1rem;
    color: var(--paper);
    background: rgba(32, 48, 39, 0.88);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.55rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .field-hero__note {
    grid-area: note;
    padding: 1.4rem clamp(1.25rem, 4vw, 4.5rem);
    border-top: 1px solid var(--rule);
  }

  .field-hero__note span,
  .field-about__label {
    color: var(--rust);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .field-hero__note p {
    margin: 0.45rem 0 0;
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: 1.15rem;
    font-style: italic;
  }

  .field-practice,
  .field-work,
  .field-about {
    display: grid;
    grid-template-columns: minmax(19rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(3rem, 7vw, 9rem);
    padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 4vw, 4.5rem);
    border-bottom: 1px solid var(--ink);
  }

  .field-practice h2,
  .field-work h2,
  .field-about h2 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 5.6rem);
    font-weight: 480;
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .field-practice ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .field-practice li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
  }

  .field-practice li > span {
    color: var(--rust);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.65rem;
  }

  .field-practice h3 {
    margin-bottom: 0.65rem;
    font-size: clamp(1.6rem, 2.5vw, 2.35rem);
    font-weight: 520;
  }

  .field-practice li p {
    max-width: 39rem;
    margin-bottom: 0;
    color: var(--moss);
  }

  .field-principle {
    padding: clamp(5rem, 11vw, 11rem) clamp(1.25rem, 8vw, 10rem);
    margin: 0;
    color: var(--paper);
    background: var(--ink);
    text-align: center;
  }

  .field-principle span {
    color: #d48162;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .field-principle p,
  .field-principle strong {
    display: block;
    max-width: 23ch;
    margin-inline: auto;
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 5.8rem);
    font-weight: 380;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .field-principle p {
    margin-top: 2rem;
    margin-bottom: 0.25rem;
  }

  .field-principle strong {
    color: #d48162;
    font-style: italic;
  }

  .field-work {
    grid-template-columns: minmax(19rem, 0.5fr) minmax(0, 1.5fr);
  }

  .field-work__list {
    border-top: 1px solid var(--ink);
  }

  .field-work__list > a {
    display: grid;
    grid-template-columns: 2.5rem minmax(14rem, 0.8fr) minmax(16rem, 1.2fr) 2rem;
    gap: 1.2rem;
    align-items: start;
    padding: 1.8rem 0;
    color: inherit;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  .field-work__number,
  .field-work__copy p {
    font-family: "JetBrains Mono Variable", monospace;
  }

  .field-work__number,
  .field-work__list div > p {
    color: var(--rust);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .field-work__list div > p {
    margin-bottom: 0.5rem;
  }

  .field-work h3 {
    margin-bottom: 0;
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-weight: 530;
    line-height: 1.05;
  }

  .field-work__description {
    margin-bottom: 0;
    color: var(--moss);
    font-size: 0.88rem;
  }

  .field-work__arrow {
    justify-self: end;
    font-size: 1.2rem;
    transition: transform 180ms ease;
  }

  .field-work__list > a:hover .field-work__arrow {
    transform: translate(0.25rem, -0.25rem);
  }

  .field-about {
    grid-template-columns: 12rem minmax(0, 1fr) 14rem;
  }

  .field-about__label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-about__copy {
    max-width: 53rem;
  }

  .field-about__copy h2 {
    margin-bottom: 2.5rem;
  }

  .field-about__copy p {
    max-width: 47rem;
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.45;
  }

  .field-about__stamp {
    display: grid;
    align-self: start;
    aspect-ratio: 1;
    place-items: center;
    padding: 1rem;
    color: var(--rust);
    border: 2px solid currentColor;
    border-radius: 50%;
    text-align: center;
    transform: rotate(8deg);
  }

  .field-about__stamp span {
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: 3.8rem;
    font-weight: 650;
    line-height: 0.7;
  }

  .field-about__stamp small {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }

  .field-footer {
    min-height: 75svh;
    padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 6vw, 7rem) 7rem;
    color: var(--paper);
    background: var(--rust);
  }

  .field-footer .field-role {
    color: var(--paper);
  }

  .field-footer h2 {
    max-width: 12ch;
    margin-bottom: 2rem;
    font-size: clamp(4rem, 9vw, 10rem);
    font-weight: 480;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .field-footer > a {
    color: inherit;
    font-family: "Fraunces Variable", Georgia, serif;
    font-size: clamp(1.3rem, 2.5vw, 2.4rem);
  }

  .field-footer > div {
    display: flex;
    justify-content: space-between;
    padding-top: 6rem;
    margin-top: 6rem;
    border-top: 1px solid rgba(236, 229, 213, 0.5);
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .field-footer nav {
    display: flex;
    gap: 1rem;
  }

  .field-footer nav a {
    color: inherit;
    text-underline-offset: 0.2rem;
  }

  @media (max-width: 900px) {
    .field-header {
      grid-template-columns: 1fr auto;
      gap: 0.8rem 1.5rem;
      padding-block: 0.8rem;
    }

    .field-header nav {
      grid-column: 1 / -1;
      justify-content: space-between;
      padding-top: 0.75rem;
      border-top: 1px solid var(--rule);
    }

    .field-hero {
      grid-template-areas:
        "index"
        "copy"
        "portrait"
        "note";
      grid-template-columns: 1fr;
    }

    .field-hero__portrait {
      min-height: 34rem;
      border-top: 1px solid var(--ink);
      border-left: 0;
    }

    .field-practice,
    .field-work,
    .field-about {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .field-about {
      grid-template-columns: 1fr;
    }

    .field-about__stamp {
      width: 10rem;
    }
  }

  @media (max-width: 620px) {
    .field-hero__index span:last-child,
    .field-actions p {
      display: none;
    }

    .field-hero__copy {
      padding-block: 5rem;
    }

    .field-work__list > a {
      grid-template-columns: 2rem 1fr 1rem;
    }

    .field-work__description {
      display: none;
    }

    .field-footer > div {
      flex-direction: column;
      gap: 0.75rem;
    }

    .field-footer nav {
      flex-wrap: wrap;
    }
  }
</style>
