---
interface Props {
  current?: string;
}

const { current = "" } = Astro.props;
const concepts = [
  { slug: "field-guide", short: "01", label: "Field Guide" },
  { slug: "working-studio", short: "02", label: "Working Studio" },
  { slug: "signal-office", short: "03", label: "Signal Office" },
  { slug: "wonder-cabinet", short: "04", label: "Wonder Cabinet" },
  { slug: "night-school", short: "05", label: "Night School" },
];
---

<nav class="design-switcher" aria-label="Design concepts">
  <a class="design-switcher__home" href="/designs/">All five</a>
  <span class="design-switcher__rule" aria-hidden="true"></span>
  <div class="design-switcher__items">
    {concepts.map((concept) => (
      <a
        class:list={{ "is-current": current === concept.slug }}
        href={`/designs/${concept.slug}/`}
        aria-label={concept.label}
        aria-current={current === concept.slug ? "page" : undefined}
      >
        <span aria-hidden="true">{concept.short}</span>
        <strong>{concept.label}</strong>
      </a>
    ))}
  </div>
</nav>

<style>
  .design-switcher {
    position: fixed;
    right: 50%;
    bottom: 1rem;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    width: max-content;
    max-width: calc(100vw - 2rem);
    padding: 0.55rem 0.65rem 0.55rem 0.8rem;
    color: #f7f2e8;
    background: rgba(17, 18, 17, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    box-shadow: 0 0.7rem 2.6rem rgba(0, 0, 0, 0.22);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.68rem;
    line-height: 1;
    transform: translateX(50%);
    backdrop-filter: blur(14px);
  }

  .design-switcher a {
    color: inherit;
    text-decoration: none;
  }

  .design-switcher__home {
    padding: 0.45rem 0.3rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .design-switcher__rule {
    align-self: stretch;
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .design-switcher__items {
    display: flex;
    gap: 0.2rem;
  }

  .design-switcher__items a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 2.15rem;
    padding: 0.45rem 0.58rem;
    border-radius: 999px;
    transition:
      color 160ms ease,
      background 160ms ease;
  }

  .design-switcher__items a > span {
    opacity: 0.62;
  }

  .design-switcher__items strong {
    display: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .design-switcher__items a:hover,
  .design-switcher__items a.is-current {
    color: #171817;
    background: #f7f2e8;
  }

  .design-switcher__items a.is-current strong {
    display: inline;
  }

  @media (max-width: 620px) {
    .design-switcher {
      right: 0.65rem;
      bottom: 0.65rem;
      left: 0.65rem;
      justify-content: space-between;
      max-width: none;
      transform: none;
    }

    .design-switcher__items {
      flex: 1;
      justify-content: space-between;
    }

    .design-switcher__items a {
      justify-content: center;
      min-width: 1.8rem;
      padding-inline: 0.38rem;
    }

    .design-switcher__items a.is-current strong {
      display: none;
    }
  }
</style>
